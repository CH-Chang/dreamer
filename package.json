{
  "name": "dreamer-monorepo",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "web",
    "server"
  ],
  "scripts": {
    "dev:web": "npm --prefix web run dev",
    "dev:server": "npm --prefix server run dev",
    "build:web": "npm --prefix web run build",
    "build:server": "npm --prefix server run build",
    "test": "npm --prefix web run test && npm --prefix server run test",
    "test:web": "npm --prefix web run test",
    "test:server": "npm --prefix server run test",
    "lint": "npm --prefix web run lint"
  }
}
